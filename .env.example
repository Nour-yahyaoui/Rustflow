# Copy to .env; never commit populated values. Generate a strong local database password.
POSTGRES_USER=requestlab
POSTGRES_DB=requestlab
POSTGRES_PASSWORD=
# Set for CLI commands; Compose constructs its internal URL from the values above.
DATABASE_URL=
# Exact external origin, no trailing slash. Use HTTPS in production.
APP_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
# URL-encode username/password components. Use SMTPS or a STARTTLS-enforcing relay.
SMTP_URL=
MAIL_FROM=
# Optional dedicated, empty PostgreSQL DB for the integration suite (never production).
TEST_DATABASE_URL=
NEXT_TELEMETRY_DISABLED=1

# Enable only behind a private reverse proxy that overwrites X-Real-IP, never on an exposed Next server.
TRUST_PROXY_IP=0

# Optional public desktop portal link. This is not a secret and does not enable desktop synchronization.
VITE_CLOUD_PORTAL_URL=
