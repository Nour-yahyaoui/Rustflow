{
  "name": "requestlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "services/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts --host 0.0.0.0",
    "build": "tsc -p apps/desktop/tsconfig.json && vite build --config apps/desktop/vite.config.ts",
    "typecheck": "tsc -p apps/desktop/tsconfig.json && tsc -p services/api/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:api": "tsx services/api/src/server.ts",
    "dev:web": "npm run dev -w @requestlab/web",
    "build:web": "npm run build -w @requestlab/web",
    "desktop": "npm run tauri -w @requestlab/desktop -- dev",
    "desktop:build": "npm run tauri -w @requestlab/desktop -- build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx services/api/src/migrate.ts",
    "jobs": "tsx services/api/src/jobs.ts",
    "benchmark": "tsx tools/benchmark.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.56.0",
    "motion": "^12.23.0",
    "quickjs-emscripten": "^0.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
