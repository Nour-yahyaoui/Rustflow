# Substitute your owned hostname before deploying. Caddy obtains HTTPS certificates.
{$PUBLIC_HOST} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    request_body {
        max_size 1MB
    }
    reverse_proxy 127.0.0.1:3000 {
        # Overwrite the IP header; never trust a browser-supplied value.
        header_up X-Real-IP {remote_host}
    }
}
